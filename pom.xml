<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.watermelon.ci</groupId>
    <artifactId>watermelon-ci</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Watermelon CI</name>
    <description>Enterprise CI/CD platform with Git, issues, RBAC, Jenkins shell, artifact registries and deployed container observability</description>

    <modules>
        <module>platform-common</module>
        <module>platform-domain</module>
        <module>platform-manifest</module>
        <module>platform-jenkins</module>
        <module>platform-git</module>
        <module>platform-identity</module>
        <module>platform-issues</module>
        <module>platform-registry</module>
        <module>platform-runtime</module>
        <module>platform-fleet</module>
        <module>platform-secrets</module>
        <module>platform-gitops</module>
        <module>platform-orchestration</module>
        <module>platform-api</module>
        <module>platform-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.13</springdoc.version>
        <json-schema-validator.version>1.5.9</json-schema-validator.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-common</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-domain</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-manifest</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-jenkins</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-git</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-identity</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-issues</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-registry</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-runtime</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-fleet</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-secrets</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-gitops</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-orchestration</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.watermelon.ci</groupId><artifactId>platform-api</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId><version>${springdoc.version}</version></dependency>
            <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><version>${json-schema-validator.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

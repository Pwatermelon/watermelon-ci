жыелма барлык_конструкциялар ::

  сан кабат <- 3
  суз исем <- "storefront"
  тезма хезмэтлар <- ["api", "ui", "db"]

  эшлама салам (суз кем) ::
    чыгар ("Привет,", кем)
    кайтар
  ахыр

  салам (исем)

  агар (кабат > 0) булса ::
    чыгар ("настройка идёт")
  юкса ::
    чыгар ("остановлено")
  ахыр

  сан i <- 0
  шулай (i < озынлык (хезмэтлар)) вакыт ::
    чыгар ("сервис:", хезмэтлар[i])
    i <- i + 1
  ахыр

  очен (сан j <- 0 да j < кабат кадак j <- j + 1) ::
    чыгар ("итерация", j)
  ахыр

  сан сумма <- 10 * 2 + 5
  чыгар ("сумма=", сумма)

ахыр жыелма.
